rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Auth & Identity checks
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Static Schema Validation
    function isValidUser(data) {
      return data.userId is string && data.userId.size() <= 128
          && data.email is string && data.email.size() <= 128
          && data.xp is int
          && data.stars is int
          && data.level is int;
    }

    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data);
      allow delete: if false;

      match /logs/{logId} {
        allow read, list: if isOwner(userId);
        allow create: if isOwner(userId)
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.habitId is string
                    && request.resource.data.xpGained is int
                    && request.resource.data.starsGained is int;
        allow update, delete: if false;
      }
    }
  }
}
